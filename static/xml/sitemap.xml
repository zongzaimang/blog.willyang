---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for menu in site.menu %}
  {%- unless menu.url contains '://' %}
  <url><loc>{{ site.domainUrl | append: site.baseurl | append: menu.url | escape }}</loc></url>
  {%- endunless %}
  {%- endfor %}
  {%- for post in site.posts %}
  <url>
    <loc>{{ site.domainUrl | append: site.baseurl | append: post.url | escape }}</loc>
    <lastmod>{{ post.updated_at | default: post.date | date: "%Y-%m-%d" }}</lastmod>
  </url>
  {%- endfor %}
</urlset>
